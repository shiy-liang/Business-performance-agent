# Copy to .env, then paste the Supabase Transaction pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=replace-with-your-bailian-workspace-id
APP_ENV=development
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_BACKUP_COUNT=14
LOG_TIMEZONE=Asia/Singapore
# Optional; defaults to <project-root>/logs
# LOG_DIRECTORY=logs
