# Primary PostgreSQL connection string used by the API and data-management scripts.
DATABASE_URL=
# Optional SELECT-only PostgreSQL connection string used by Agent tools; blank falls back to DATABASE_URL.
AGENT_READONLY_DATABASE_URL=
# Aliyun Bailian API key used by chat and embedding clients.
DASHSCOPE_API_KEY=
# Aliyun Bailian workspace identifier used to construct the compatible API endpoint.
DASHSCOPE_WORKSPACE_ID=
# Deployment environment label included in structured logs.
APP_ENV=development
# Minimum console logging level.
LOG_CONSOLE_LEVEL=INFO
# Minimum rotating-file logging level.
LOG_FILE_LEVEL=DEBUG
# Number of rotated daily log files retained.
LOG_BACKUP_COUNT=14
# Whether the rotating log handler uses UTC rollover calculations.
LOG_ROTATE_UTC=true
# Directory used for application log files.
LOG_DIRECTORY=logs
# IANA timezone used when formatting log timestamps.
LOG_TIMEZONE=Asia/Singapore
