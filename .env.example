# Copy to .env, then paste the Supabase Transaction pooler connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
# Recommended: a PostgreSQL role with SELECT-only grants for Agent SQL tools.
# Falls back to DATABASE_URL while still forcing a read-only transaction.
AGENT_READONLY_DATABASE_URL=postgresql://readonly.PROJECT_REF:PASSWORD@HOST:6543/postgres
AGENT_SQL_TIMEOUT_MS=5000
AGENT_SQL_MAX_ROWS=500
# Prevent large result sets from consuming the specialist model context.
AGENT_SQL_MAX_RESULT_CHARS=30000
AGENT_SQL_MAX_ATTEMPTS=3
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=replace-with-your-bailian-workspace-id
APP_ENV=development
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=DEBUG
LOG_BACKUP_COUNT=14
LOG_TIMEZONE=Asia/Singapore
# Optional; defaults to <project-root>/logs
# LOG_DIRECTORY=logs
